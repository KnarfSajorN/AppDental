-- ------------------------------
--  asistenteVirtualCommandsUsers
-- ------------------------------
create table asistenteVirtualCommandsUsers (
    id int not null auto_increment,
    fechaRegistro timestamp null default current_timestamp,
    activo int null default 1,
    comando text null default null,
    usuarioId int null default 0,
    commandId int null default 0,
    preguntas text null default null,
    random text null default null,
    primary key (id)
);

-- ------------------------------
--  asistenteVirtualConfig
-- ------------------------------
create table asistenteVirtualConfig (
    id int not null auto_increment,
    fechaRegistro timestamp null default current_timestamp,
    nombre text null default null,
    idioma text null default null,
    saludo text null default null,
    modoUso text null default null,
    activo int null default 1,
    usuarioId int null default 0,
    primary key (id)
);
# Asistente virtual
RewriteRule ^asistente$ asistenteVirtual/asistenteVirtualConfig.php
RewriteRule ^asistenteConfig$ asistenteVirtual/asistenteVirtualConfigOpcion.php
RewriteRule ^asistenteV$ asistenteVirtual/asistenteVisual.php
# Asistente virtual - fin
-- insertar opciones en el menu desde "Perfiles_RegistrarNuevoMenu"

-- ------------------------------
-- tablas que se deben crear
-- ------------------------------
-- ------------------------------
--  asistenteAuditor
-- ------------------------------
create table asistenteAuditor (
    id int not null auto_increment,
    fechaRegistro timestamp null default current_timestamp,
    idUsuario int null default 0,
    mensaje text null default null,
    primary key (id)
);

-- ------------------------------
--  asistenteVirtualCommands
-- ------------------------------
create table asistenteVirtualCommands (
    id int not null auto_increment,
    categoria int null default 0,
    nombre text null default null,
    icon text null default null,
    color text null default null,
    estado int null default 1,
    primary key (id)
);

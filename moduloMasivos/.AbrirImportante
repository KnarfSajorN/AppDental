# insert into medicaso_dev_baseGeneral.main_menu
# (nombre, nivel, pantalla, idPrincipal, estado)
# values
# ('Mensajer&iacute;a masiva',1,'#',0,1),
# ('Configurar',2,'masivoConfig',0,1),
# ('Lista de contactos',2,'masivoContactos',0,1),
# ('Mensajes Whatsapp',2,'masivoMensajesW',0,1),
# ('Mensajes Correo',2,'masivoMensajesC',0,1),
# ('Panel de Chat',2,'masivoWAChat',0,1)
# ;

# y luego se actualizan los ids de el sub menu con el id del menu principal "Mensajeria masiva"

update medicaso_dev_baseGeneral.main_menu 
set idPrincipal = (select id from medicaso_dev_baseGeneral.main_menu where nombre = 'Mensajer&iacute;a masiva' 
and nivel = 1 and pantalla = '#')
where nombre in ('Configurar','Lista de contactos','Filtros','Archivos Publicitarios','Mensajes Whatsapp','Mensajes Correo','Bot - Saludos','Bot - Mensajes') 
and nivel = 2 
and pantalla in ('masivoConfig','masivoContactos','masivoFiltros','masivoArchivos','masivoMensajesW','masivoMensajesC','masivoWASaludo','masivoWAMensajes');


# una vez registrado el menu se debe ir a configuracion y perfil -> usuarios -> Gestionar perfiles -> administrar grupos, para agregar las opciones en el menu del cliente


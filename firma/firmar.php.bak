<?php
include '../funciones/funciones.php';
include '../../masterFunciones_co215.php';


$conn3 = mysqli_connect($host,$userdb,$pass2,$DB)or die ('Ha fallado la conexion MySQL: '.mysqli_error($conn3));
$id = $_GET['id'];
$tipo = $_GET['tipo'];
$cliente = $_GET['cliente'];
$cuentas = 0;
$fecha = date("Y-m-d");
$hora  = date("h:m:s");


/*
hc0 = hisotria clinica general
hc2 = hisotria clinica spa
hc5 = Tratamiento estetico




*/


$queryList1=mysqli_query($conn3,"SELECT count(id) as cuentas FROM  firmas where historia_id = $id and historia_nombre = '$tipo'");
$nrowl=mysqli_num_rows($queryList1);
while($rowMotorizado=mysqli_fetch_array($queryList1))
{
  $cuentas = $rowMotorizado['cuentas']; 
}

 


if ($cuentas == 0 ) 
{
  

        mysqli_query($conn3,"INSERT INTO firmas (cliente_id, fecha, hora, historia_id, historia_nombre) VALUES ('$cliente', '$fecha', '$hora', '$id', '$tipo');");

         
        $queryList2=mysqli_query($conn3,"SELECT * FROM  firmas where historia_id = $id and historia_nombre = $tipo");
        $nrowl=mysqli_num_rows($queryList2);
        while($row2=mysqli_fetch_array($queryList2))
        {
          $idFirma = $row2['id']; 
        }





}
elseif ($cuentas > 0)
{

        $queryList2=mysqli_query($conn3,"SELECT * FROM  firmas where historia_id = $id and historia_nombre = '$tipo'");
        $nrowl=mysqli_num_rows($queryList2);
        while($row2=mysqli_fetch_array($queryList2))
        {
          $idFirma = $row2['id']; 
        }
         
}





$queryList=mysqli_query($conn3,"SELECT firma FROM  firmas where id = $idFirma");
$nrowl=mysqli_num_rows($queryList);
while($rowMotorizado=mysqli_fetch_array($queryList))
{
  $firma = $rowMotorizado['firma']; 
}

if (strlen($firma)>10) 
{
      echo "<script>alert('Su firma ya a sido Registrada');window.location='https://hellomedical.net/';</script>";
}
else
{

     
    $queryList=mysqli_query($conn3,"SELECT * FROM  cliente where cliente_id = $cliente ");
    $nrowl=mysqli_num_rows($queryList);
    while($rowMotorizado=mysqli_fetch_array($queryList))
    {
      $whatsapp = $rowMotorizado['whatsapp']; 
    }
    $mensaje = 'Para realizar la firma entre el siguiente link '.$Base.'firma/firmardocumento/'.$id.'/0/'.$cliente;

     
    Whatsapp_sent($linkkey, $whatsapp, $mensaje);


} 



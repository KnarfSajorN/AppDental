# -------------------------------------------------
# base de datos para las salas
# -------------------------------------------------
# para el uso de las salas dinámicas , una vez iniciada una sala desde el doctor se creara un registro en la base de datos
# este se encuentra alojado en una base distinta a todos los sistemas para unificar las salas a esa tabla
# -------------------------------------------------
# base de datos: medicaso_videoConsulta
# Tabla: salas
# -------------------------------------------------
# esta tabla tiene los siguientes campos
# id -- clave primaria
# fechaC -- fecha de creación
# fechaF -- fecha de finalización
# sistema -- código del sistema
# sala -- código único de la sala
# estado -- 1 = activa, 0 = inactiva
# idCitas -- id de la cita de Medical
# -------------------------------------------------


